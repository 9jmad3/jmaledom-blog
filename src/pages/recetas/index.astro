---
import { getCollection } from 'astro:content'; import BaseHead from '../../components/BaseHead.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import ContentCard from '../../components/ContentCard.astro'; import { listStoredContent } from '../../lib/content-store';
export const prerender=false; const staticItems=await getCollection('recetas'); const staticSlugs=new Set(staticItems.map((item)=>item.id)); const storedItems=(await listStoredContent('recetas')).filter((item)=>!staticSlugs.has(item.slug));
---
<html lang="es"><head><BaseHead title="Recetas · jmaledom" description="Recetas que preparo, repito y merece la pena guardar." /></head><body><Header/><main class="listing"><header><p>Comer bien, sin drama</p><h1>Recetas</h1><div>Platos que preparo de verdad: sencillos, ricos y compatibles con una vida normal.</div></header><section>{storedItems.map((item)=><ContentCard href={`/recetas/${item.slug}/`} title={item.title} description={item.description} eyebrow={item.tags.join(' · ')} meta={`${item.details.time} min · ${item.details.difficulty} · ${item.details.servings} raciones`} image={item.imagePath} tone="food" />)}{staticItems.map((item)=><ContentCard href={`/recetas/${item.id}/`} title={item.data.title} description={item.data.description} eyebrow={item.data.tags.join(' · ')} meta={`${item.data.time} min · ${item.data.difficulty} · ${item.data.servings} raciones`} image={item.data.heroImage} tone="food" />)}</section></main><Footer/></body></html>
<style>.listing{width:min(920px,calc(100% - 2rem));padding-top:5rem}.listing>header{max-width:720px;margin-bottom:3rem}.listing>header>p{margin:0;color:var(--accent);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.listing h1{margin:.2rem 0;font-size:clamp(4rem,10vw,7rem);letter-spacing:-.07em}.listing>header>div{color:var(--muted);font-size:1.15rem}.listing section{display:grid;gap:1.2rem}</style>
