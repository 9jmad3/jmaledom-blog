---
import { getEntry, render } from 'astro:content'; import GuideLayout from '../../layouts/GuideLayout.astro'; import { getStoredContent } from '../../lib/content-store'; import { recipeInteractionKey } from '../../lib/interaction-target';
export const prerender=false; const slug=Astro.params.slug!; const entry=await getEntry('recetas',slug); const stored=entry?null:await getStoredContent('recetas',slug); if(!stored&&!entry)return Astro.redirect('/404'); const rendered=entry?await render(entry):null; const d:any=stored?{...stored.details,title:stored.title,description:stored.description,tags:stored.tags,heroImage:stored.imagePath}:entry!.data;
---
<GuideLayout title={d.title} description={d.description} section="Recetas" backHref="/recetas" heroImage={d.heroImage} tags={d.tags} interactionKey={recipeInteractionKey(slug)} facts={[{label:'Tiempo',value:`${d.time} min`},{label:'Dificultad',value:String(d.difficulty)},{label:'Raciones',value:String(d.servings)},...(d.protein?[{label:'Proteína aprox.',value:`${d.protein} g`}]:[])]}>{stored?<Fragment set:html={stored.bodyHtml}/>:rendered&&<rendered.Content/>}</GuideLayout>
