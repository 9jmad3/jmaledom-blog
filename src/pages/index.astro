---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION } from '../consts';
import '../styles/book.css';
import '../styles/book-cover.css';
---
<!doctype html>
<html lang="es">
  <head><BaseHead title="Pequeñas historias · jmaledom" description={SITE_DESCRIPTION} /></head>
  <body class="book-site cover-site">
    <main class="cover-stage">
      <a class="closed-book" href="/blog/" aria-label="Abrir el libro Pequeñas historias de José">
        <div class="cover-spine" aria-hidden="true">José · jmaledom</div>
        <div class="cover-face">
          <span class="cover-author">José</span>
          <div class="cover-title"><p>jmaledom</p><h1>Pequeñas<br /><em>historias.</em></h1><span class="cover-rule"></span><p class="cover-subtitle">De lo que vivo.<br />De lo que me hace pensar.</p></div>
          <div class="cover-ornament" aria-hidden="true">❧</div>
          <span class="cover-edition">Una vida entre páginas</span>
        </div>
      </a>
      <a class="open-book-link" href="/blog/">Abrir el libro <span aria-hidden="true">↗</span></a>
      <p class="cover-note">Historias que se siguen escribiendo.</p>
    </main>
  </body>
</html>
