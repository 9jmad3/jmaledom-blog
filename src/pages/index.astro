---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latest = async (name: 'blog' | 'recetas') =>
	(await getCollection(name)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const [post, recipe] = await Promise.all([latest('blog'), latest('recetas')]);
const areas = [
	{ href: '/blog', title: 'Reflexiones', copy: 'Lo que pienso, lo que vivo y las ideas que necesito escribir.', tone: 'thought', latest: post && { href: `/blog/${post.id}/`, title: post.data.title } },
	{ href: '/recetas', title: 'Recetas', copy: 'Platos sencillos que preparo, repito y merece la pena guardar.', tone: 'food', latest: recipe && { href: `/recetas/${recipe.id}/`, title: recipe.data.title } },
];
---
<!doctype html>
<html lang="es">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="home">
			<section class="hero"><p class="eyebrow">Hola, soy José</p><h1>Una vida no cabe<br />en una sola categoría<span>.</span></h1><p>Este es mi espacio personal: reflexiones, recetas y todo lo que vaya apareciendo por el camino.</p><a href="#explorar">Explorar la web ↓</a></section>
			<section class="areas" id="explorar" aria-labelledby="areas-title"><header><p class="eyebrow">Todo en un mismo sitio</p><h2 id="areas-title">Elige por dónde empezar</h2></header><div class="area-grid">{areas.map((area) => <article class={area.tone}><a class="area-main" href={area.href}><h3>{area.title}</h3><p>{area.copy}</p><strong>Entrar →</strong></a>{area.latest && <a class="latest-link" href={area.latest.href}><small>Lo último</small><span>{area.latest.title}</span></a>}</article>)}</div></section>
			<section class="about-strip"><div><p class="eyebrow">Detrás de jmaledom</p><h2>José, sin demasiadas etiquetas.</h2><p>Gym por salud mental, salsa y bachata porque el cuerpo también piensa, y curiosidad por casi todo lo demás.</p></div><a href="/about">Conóceme mejor →</a></section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.home .hero { max-width: none; }
	.home .hero h1 { max-width: none; }
	.home .areas { margin-top: 7rem; }
	.home .area-grid { grid-template-columns: 1fr; }
	.home .latest-link { display: grid; grid-template-columns: auto minmax(0, 1fr); font-size: .9rem; }
	.home .latest-link span { white-space: nowrap; }
	@media (max-width: 720px) {
		.home .latest-link span { white-space: normal; }
	}
</style>
<style>
	.home{display:block;width:min(1120px,calc(100% - 2rem));min-height:0;padding-top:6rem}.hero{max-width:1000px}.eyebrow{margin:0;color:var(--accent);font-size:.76rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.hero h1{margin:.35rem 0 1.5rem;font-size:clamp(3.8rem,9vw,7.5rem);letter-spacing:-.075em;line-height:.88}.hero h1 span{color:var(--accent)}.hero>p:not(.eyebrow){max-width:680px;color:var(--muted);font-size:1.2rem}.hero>a{display:inline-block;margin-top:1rem;color:var(--text);font-weight:800;text-decoration:none}.manifesto{display:grid;grid-template-columns:repeat(4,1fr);margin:7rem 0;padding:2rem 0;border-block:1px solid var(--border)}.manifesto p{margin:0;font-size:clamp(1.5rem,3vw,2.5rem);font-weight:800;letter-spacing:-.04em}.manifesto small{grid-column:1/-1;margin-top:1rem;color:var(--muted)}.areas>header{margin-bottom:2rem}.areas h2,.about-strip h2{margin:.25rem 0;font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-.05em}.area-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.area-grid article{display:flex;min-height:370px;overflow:hidden;background:var(--surface);border:1px solid var(--border);border-radius:24px;flex-direction:column}.area-main{display:flex;padding:2rem;flex:1;flex-direction:column;color:var(--text);text-decoration:none}.area-main>span{color:var(--muted);font-size:.75rem;font-weight:800}.area-main h3{margin:auto 0 .5rem;font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-.06em}.area-main p{max-width:430px;margin:0 0 1rem;color:var(--muted);line-height:1.5}.area-main strong{color:var(--accent)}.latest-link{display:flex;padding:1rem 2rem;color:var(--text);background:color-mix(in srgb,var(--background) 65%,transparent);border-top:1px solid var(--border);gap:1rem;text-decoration:none;align-items:baseline}.latest-link small{color:var(--accent);font-weight:800;text-transform:uppercase;letter-spacing:.08em}.food{border-top:5px solid #d89c45!important}.training{border-top:5px solid #719279!important}.style{border-top:5px solid #8a829c!important}.thought{border-top:5px solid var(--accent)!important}.about-strip{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-top:7rem;padding:3rem;background:var(--text);border-radius:24px}.about-strip h2{color:var(--background)}.about-strip>div>p:last-child{max-width:650px;margin-bottom:0;color:color-mix(in srgb,var(--background) 72%,transparent)}.about-strip>a{flex:0 0 auto;color:var(--background);font-weight:800;text-decoration:none}@media(max-width:720px){.home{padding-top:3rem}.manifesto{grid-template-columns:repeat(2,1fr);gap:1rem}.area-grid{grid-template-columns:1fr}.about-strip{align-items:start;padding:2rem;flex-direction:column}.latest-link{align-items:start;flex-direction:column;gap:.2rem}}
</style>
