---
import { getCollection } from 'astro:content';
import BookLayout from '../../layouts/BookLayout.astro';
const posts = (await getCollection('blog')).sort((a,b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const roman = ['I','II','III','IV','V','VI','VII','VIII','IX','X'];
---
<BookLayout title="Índice · Pequeñas historias" description="El índice del libro de José: pequeñas historias sobre lo que vivo y lo que me hace pensar." runningTitle="Índice" previous={{href:'/',label:'Portada'}} next={{href:posts[0] ? `/blog/${posts[0].id}/` : '/about/',label:'Primera historia'}}>
  <section class="book-page book-title-page">
    <p class="book-kicker">José · jmaledom</p>
    <h1>Pequeñas<br /><em>historias.</em></h1>
    <p class="book-ornament" aria-hidden="true">❧</p>
    <p class="dedication">Una vida no cabe<br />en una sola categoría.</p>
    <p class="book-kicker">Un libro que se sigue escribiendo</p>
  </section>
  <section class="book-contents">
    <p class="book-kicker">Elige una página. Quédate un rato.</p>
    <h1>Índice</h1>
    <ol>{posts.map((post,index) => <li><a href={`/blog/${post.id}/`}><span class="chapter-number">{roman[index] ?? index+1}</span><span class="chapter-label">{post.data.title}</span><span class="leader" aria-hidden="true"></span></a></li>)}</ol>
    <ul class="backmatter"><li><a href="/about/">Sobre el autor <span class="leader" aria-hidden="true"></span></a></li><li><a href="/creditos/">Colofón y privacidad <span class="leader" aria-hidden="true"></span></a></li></ul>
  </section>
</BookLayout>
