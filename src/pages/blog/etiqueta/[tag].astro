---
import { type CollectionEntry, getCollection } from 'astro:content';
import BookLayout from '../../../layouts/BookLayout.astro';
import { SITE_TITLE } from '../../../consts';
import { BLOG_TAG_SLUGS, getTagLabel, getTagUrl, type BlogTag } from '../../../lib/tags';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
	const chapters = posts.map((post, index) => ({ post, number: index + 1 }));
	return BLOG_TAG_SLUGS.map((tag) => ({
		params: { tag },
		props: { tag, chapters: chapters.filter(({ post }) => post.data.tags.includes(tag)) },
	}));
}

interface Props {
	tag: BlogTag;
	chapters: { post: CollectionEntry<'blog'>; number: number }[];
}

const { tag, chapters } = Astro.props;
const label = getTagLabel(tag);
---

<BookLayout title={`${label} · ${SITE_TITLE}`} description={`Historias de jmaledom sobre ${label.toLocaleLowerCase('es')}.`} runningTitle={label} previous={{ href: '/blog/', label: 'Índice completo' }} next={{ href: chapters[0] ? `/blog/${chapters[0].post.id}/` : '/blog/', label: 'Empezar a leer' }}>
	<section class="book-page book-title-page">
		<p class="book-kicker">Un hilo entre las páginas</p>
		<h1>{label}</h1>
		<p class="book-ornament" aria-hidden="true">❦</p>
		<p class="dedication">{chapters.length} {chapters.length === 1 ? 'historia' : 'historias'} sobre {label.toLocaleLowerCase('es')}.</p>
	</section>
	<section class="book-page book-contents">
		<p class="book-kicker">Índice temático</p>
		<h1>Las historias</h1>
		<ol>
			{chapters.map(({ post, number }) => (
				<li><a href={`/blog/${post.id}/`}><span class="chapter-number">{String(number).padStart(2, '0')}</span><span class="chapter-label">{post.data.title}</span><span class="leader" aria-hidden="true"></span></a></li>
			))}
		</ol>
		<div class="backmatter">
			<p class="book-kicker">Otros hilos</p>
			<ul>
				{BLOG_TAG_SLUGS.filter((item) => item !== tag).map((item) => <li><a href={getTagUrl(item)}>{getTagLabel(item)}</a></li>)}
				<li><a href="/blog/">Todas las historias →</a></li>
			</ul>
		</div>
	</section>
</BookLayout>
