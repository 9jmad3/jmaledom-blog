---
import { getCollection } from 'astro:content'; import BaseHead from '../../components/BaseHead.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import ContentCard from '../../components/ContentCard.astro'; import { listStoredContent } from '../../lib/content-store';
export const prerender=false; const staticItems=await getCollection('entrenos'); const storedItems=await listStoredContent('entrenos');
---
<html lang="es"><head><BaseHead title="Entrenos · jmaledom" description="Rutinas y sesiones que forman parte de mi manera de entrenar." /></head><body><Header/><main class="listing"><header><p>Gym por salud mental</p><h1>Entrenos</h1><div>Lo que hago, cómo lo organizo y qué me funciona. Experiencia personal, no una receta universal.</div></header><section>{storedItems.map((item)=><ContentCard href={`/entrenos/${item.slug}/`} title={item.title} description={item.description} eyebrow={item.tags.join(' · ')} meta={`${item.details.duration} min · ${item.details.level} · ${item.details.goal}`} image={item.imagePath} tone="training" />)}{staticItems.map((item)=><ContentCard href={`/entrenos/${item.id}/`} title={item.data.title} description={item.data.description} eyebrow={item.data.tags.join(' · ')} meta={`${item.data.duration} min · ${item.data.level} · ${item.data.goal}`} image={item.data.heroImage} tone="training" />)}</section></main><Footer/></body></html>
<style>.listing{width:min(920px,calc(100% - 2rem));padding-top:5rem}.listing>header{max-width:720px;margin-bottom:3rem}.listing>header>p{margin:0;color:var(--accent);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.listing h1{margin:.2rem 0;font-size:clamp(4rem,10vw,7rem);letter-spacing:-.07em}.listing>header>div{color:var(--muted);font-size:1.15rem}.listing section{display:grid;gap:1.2rem}</style>
