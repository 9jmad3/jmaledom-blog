---
import { getEntry, render } from 'astro:content'; import GuideLayout from '../../layouts/GuideLayout.astro'; import { getStoredContent } from '../../lib/content-store';
export const prerender=false; const slug=Astro.params.slug!; const stored=await getStoredContent('entrenos',slug); const entry=stored?null:await getEntry('entrenos',slug); if(!stored&&!entry)return Astro.redirect('/404'); const rendered=entry?await render(entry):null; const d:any=stored?{...stored.details,title:stored.title,description:stored.description,tags:stored.tags,heroImage:stored.imagePath}:entry!.data;
---
<GuideLayout title={d.title} description={d.description} section="Entrenos" backHref="/entrenos" heroImage={d.heroImage} tags={d.tags} facts={[{label:'Duración',value:`${d.duration} min`},{label:'Nivel',value:String(d.level)},{label:'Objetivo',value:String(d.goal)},{label:'Material',value:(d.equipment as string[]).join(', ')}]} note="Esta rutina refleja mi experiencia personal. Adáptala a tu nivel y consulta con un profesional si tienes dudas o alguna lesión.">{stored?<Fragment set:html={stored.bodyHtml}/>:rendered&&<rendered.Content/>}</GuideLayout>
