---
import { getCollection } from 'astro:content'; import BaseHead from '../../components/BaseHead.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import ContentCard from '../../components/ContentCard.astro';
const items=(await getCollection('estilo')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<html lang="es"><head><BaseHead title="Estilo · jmaledom" description="Conjuntos, prendas e ideas sobre mi manera de vestir." /></head><body><Header/><main class="listing"><header><p>Vestirse también cuenta cosas</p><h1>Estilo</h1><div>Conjuntos que uso, combinaciones que me funcionan y el motivo por el que volvería a ponérmelos.</div></header><section>{items.map((item)=><ContentCard href={`/estilo/${item.id}/`} title={item.data.title} description={item.data.description} eyebrow={item.data.tags.join(' · ')} meta={`${item.data.occasion} · ${item.data.season} · ${item.data.palette.join(', ')}`} image={item.data.heroImage} tone="style" />)}</section></main><Footer/></body></html>
<style>.listing{width:min(920px,calc(100% - 2rem));padding-top:5rem}.listing>header{max-width:720px;margin-bottom:3rem}.listing>header>p{margin:0;color:var(--accent);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.listing h1{margin:.2rem 0;font-size:clamp(4rem,10vw,7rem);letter-spacing:-.07em}.listing>header>div{color:var(--muted);font-size:1.15rem}.listing section{display:grid;gap:1.2rem}</style>
