---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BookLayout from './BookLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ShareButton from '../components/ShareButton.astro';
import Comments from '../components/Comments.astro';
import Reactions from '../components/Reactions.astro';
import ReadingAnalytics from '../components/ReadingAnalytics.astro';
type PostLink = { id: string; title: string };
type Props = CollectionEntry<'blog'>['data'] & { readingMinutes: number; newerPost?: PostLink; olderPost?: PostLink; };
const { title, description, pubDate, heroImage, socialImage, readingMinutes, newerPost, olderPost } = Astro.props;
const articleSlug = Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? '';
const posts = (await getCollection('blog')).sort((a,b)=>a.data.pubDate.valueOf()-b.data.pubDate.valueOf());
const chapter = posts.findIndex(post=>post.id===articleSlug)+1;
---
<BookLayout {title} {description} image={socialImage ?? heroImage} runningTitle={title} previous={olderPost ? {href:`/blog/${olderPost.id}/`,label:'Historia anterior'} : {href:'/blog/',label:'Índice'}} next={newerPost ? {href:`/blog/${newerPost.id}/`,label:'Siguiente historia'} : {href:'/about/',label:'Sobre el autor'}}>
  <header class="book-page book-chapter-heading">
    <p class="book-kicker">Historia {String(chapter).padStart(2,'0')}</p>
    <h1>{title}</h1>
    <p class="book-chapter-meta"><FormattedDate date={pubDate} /> · {readingMinutes} min de lectura</p>
    {heroImage && <Image class="chapter-photo" width={720} src={heroImage} alt={`Fotografía de la historia «${title}»`} />}
  </header>
  <article class="book-story"><slot /><div class="book-story-end"><p class="book-ornament" aria-hidden="true">❧</p><p>Hasta aquí, esta historia.</p><a href="#notas">Dejar una nota al margen</a></div></article>
  <Fragment slot="after">
    <details class="book-notes" id="notas"><summary>Notas al margen · comentarios y reacciones</summary><Reactions article={articleSlug} /><ShareButton {title} {description} /><Comments article={articleSlug} /></details>
    <ReadingAnalytics article={articleSlug} />
  </Fragment>
</BookLayout>
